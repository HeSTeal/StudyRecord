#include "chassis.h"
#include "robot_def.h"

#if defined(ONE_BOARD) || defined(CHASSIS_BOARD)
#include "can_comm.h"

 CANCommInstance *chassis_can_comm;
Chassis_Ctrl_Cmd_s chassis_cmd_recv;   // ★ 观察这个变量，不加 static 方便 Watch
#endif

void ChassisInit(void)
{
#if defined(ONE_BOARD) || defined(CHASSIS_BOARD)
    CANComm_Init_Config_s comm_conf = {
        .can_config = {
            .can_handle = &hcan1,   // ★ 必须和上板接在同一条 CAN 总线上
            .tx_id = 0x311,         // 下板发（暂时不发也无所谓，但要配上）
            .rx_id = 0x312,         // 下板收 ← 上板发的就是这个
        },
        .recv_data_len = sizeof(Chassis_Ctrl_Cmd_s),
        .send_data_len = sizeof(Chassis_Upload_Data_s),
    };
    chassis_can_comm = CANCommInit(&comm_conf);
#endif
}

void ChassisTask(void)
{
#if defined(ONE_BOARD) || defined(CHASSIS_BOARD)
    chassis_cmd_recv = *(Chassis_Ctrl_Cmd_s *)CANCommGet(chassis_can_comm);
    // 其它底盘控制、发送逻辑先全部不做
#endif
}